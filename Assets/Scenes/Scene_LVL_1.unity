      objectReference: {fileID: 0}
    - target: {fileID: 2633707270438204117, guid: da142a754a607fe448a00569908a49b6, type: 3}
      propertyPath: margeBas
      value: 0.199
      objectReference: {fileID: 0}
    - target: {fileID: 2633707270438204117, guid: da142a754a607fe448a00569908a49b6, type: 3}
      propertyPath: titreNote
      value: "Mes derni\xE8res notes"
      objectReference: {fileID: 0}
    - target: {fileID: 2633707270438204117, guid: da142a754a607fe448a00569908a49b6, type: 3}
      propertyPath: contenuNote
      value: "Voil\xE0 six jours que les Boches me retiennent prisonnier. Je crains que mes heures ne soient compt\xE9es.\n\nLes cafards envahissent les tranch\xE9es. Ces maudites bestioles grouillent partout... D\xE8s que la lumi\xE8re s'\xE9teint, elles se jettent sur nous pour nous d\xE9vorer vivants. Que Dieu me garde de finir ainsi.\n\nCes salopards de Boches se gaussent de mon malheur. Ils prennent un malin plaisir \xE0 me d\xE9rober mes notes pour les lire \xE0 haute voix, puis \xE9clatent de rire devant moi.\n\nM\xEAme dans ma mis\xE8re, ces maudits chiens ne me laissent point un instant de r\xE9pit..."
      objectReference: {fileID: 0}
    - target: {fileID: 2633707270438204117, guid: da142a754a607fe448a00569908a49b6, type: 3}
      propertyPath: margeDroite
      value: 0.108
      objectReference: {fileID: 0}
    - target: {fileID: 2633707270438204117, guid: da142a754a607fe448a00569908a49b6, type: 3}
      propertyPath: margeGauche
      value: 0.131
      objectReference: {fileID: 0}
    - target: {fileID: 2633707270438204117, guid: da142a754a607fe448a00569908a49b6, type: 3}
      propertyPath: tailleTitre
      value: 15
      objectReference: {fileID: 0}
    - target: {fileID: 2633707270438204117, guid: da142a754a607fe448a00569908a49b6, type: 3}
      propertyPath: cameraJoueur
